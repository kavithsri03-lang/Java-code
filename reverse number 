import java.util.Scanner;

public class Reverse {
    public static void main(String args[]) {
        int a, reverse = 0;

        Scanner sc = new Scanner(System.in);

        System.out.println("Enter the number");
        a = sc.nextInt();

        while (a != 0) {
            int digit = a % 10;
            reverse = reverse * 10 + digit;
            a = a / 10;
        }

        System.out.printf("%d", reverse);
    }
}